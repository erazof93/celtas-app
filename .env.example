# Celtas Mobile — configuración de entorno
# Copiar a `.env` y ajustar según el entorno.

# Producción (backend real desplegado en Render).
API_BASE_URL=

# Desarrollo local: backend corriendo en Docker en tu máquina.
# - Emulador Android: usar http://10.0.2.2:3000 (el emulador tiene su propia red virtual;
#   localhost apunta al propio emulador, NO a tu máquina host).
# - Web / iOS simulator: usar http://localhost:3000.
# API_BASE_URL=http://10.0.2.2:3000

# Client ID "Web application" de Google Cloud (proyecto celtas-b0bd5).
# Es el mismo que usa el backend para verificar el idToken en POST /auth/google.
# En Android el Client ID de tipo "Android" se vincula por package name + SHA-1
# (google-services.json), no se pega en código; este valor es el que la SDK
# necesita para emitir un idToken verificable por el servidor.
GOOGLE_SERVER_CLIENT_ID=

# API key de Geoapify (Address Autocomplete + Geocoding + Reverse Geocoding + Map Tiles),
# plan gratis: https://myprojects.geoapify.com/. Una sola key compartida por toda la app
# (rate limit: 5 req/seg TOTAL, no por usuario) — ver skill `geoapify-direcciones`.
GEOAPIFY_API_KEY=tu_api_key_de_geoapify