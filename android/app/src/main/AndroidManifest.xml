<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ (API 33): permiso en tiempo de ejecución requerido para
         mostrar notificaciones, incluidas las de FCM. Sin esto, las
         notificaciones en background/terminated tampoco se muestran en API
         33+ aunque el usuario nunca vea el diálogo de permiso. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Ubicación para el botón "Usar mi ubicación actual" del formulario de
         direcciones (feature Geoapify) — solo mientras la app está en uso,
         nunca en background. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="Celtas FastFood"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Canal por defecto que usa el SDK de FCM para mostrar la
             notificación nativamente en background/terminated — debe
             coincidir con el `AndroidNotificationChannel` que crea
             `NotificationService` para el foreground, si no la app tendría
             dos canales distintos (uno "Miscellaneous" genérico de FCM, otro
             "Celtas" propio) y el usuario podría silenciar uno sin afectar
             al otro. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="celtas_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_celtas" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Requerido por url_launcher (Android 11+/API 30, package visibility)
             para poder detectar/abrir el whatsappUrl (https://wa.me/...) del
             checkout — sin esto, canLaunchUrl devuelve false aunque WhatsApp
             esté instalado. Ver README de url_launcher: sección Android. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
